 "unkeyed": [
  {
   "id": "C04",
   "name": "Re-counting quantities when accuracy is uncertain",
   "definition": "Counts and re-counts quantities or transactions, restarting a count when its reliability is in doubt, even without reason to expect error."
  },
  {
   "id": "C06",
   "name": "Retiring systems that stop serving a use",
   "definition": "Adapts, retires or discards containers and record systems once their practical value changes, such as discarding a keepsake box after its contents are systematised."
  },
  {
   "id": "C07",
   "name": "Spatial planning by measurement and drawing",
   "definition": "Plans rooms, shops and storage on graph paper or with measurements before acting, and checks the drawings against actual use."
  },
  {
   "id": "C08",
   "name": "Money kept as an end in itself",
   "definition": "Saves and retains money for its own sake rather than for a purchase; counts and protects the store ritually."
  },
  {
   "id": "C10",
   "name": "Full commercial prices regardless of relationship",
   "definition": "Charges fixed, full prices to kin, friends, the poor or the elderly, without family or hardship discounts."
  },
  {
   "id": "C11",
   "name": "Hard bargaining as a buyer",
   "definition": "Negotiates prices down when buying, using precise counts or documented defects, sometimes pressing advantage over a less informed party."
  },
  {
   "id": "C12",
   "name": "Selective spending on capability",
   "definition": "Despite strong money retention, spends deliberately on tools, training, education or practical independence."
  },
  {
   "id": "C16",
   "name": "Understanding stalls at the explanatory gap",
   "definition": "Can repeat explanations and name parts but cannot reconstruct the mechanism, and turns back at derivations or theory."
  },
  {
   "id": "C17",
   "name": "Learning abstractions through concrete cases",
   "definition": "Makes abstract theory intelligible through hand-drawn tables, diagrams, units and worked numerical examples rather than formal mathematics alone."
  },
  {
   "id": "C19",
   "name": "Preference for inspectable mechanisms",
   "definition": "Prefers transparent, fully traceable components and explanations with explicit limits over black boxes or opaque assurances."
  },
  {
   "id": "C21",
   "name": "Effort allocated to chosen interests over schoolwork",
   "definition": "Invests effort in self-chosen technical, financial or work interests while settling for adequate school performance."
  },
  {
   "id": "C24",
   "name": "Converting failures into preventive procedures",
   "definition": "Turns mistakes, complaints and discovered failures into standing checks, revised procedures or reminder systems."
  },
  {
   "id": "C25",
   "name": "Preserving evidence of failed and superseded work",
   "definition": "Keeps failures, crossed-out entries, earlier versions and failed artefacts legible and stored rather than erasing or discarding them."
  },
  {
   "id": "C26",
   "name": "Explicit uncertainty instead of guessing",
   "definition": "Refuses to fill gaps with plausible guesses or unreliable figures; leaves blanks and states what the evidence does not establish."
  },
  {
   "id": "C27",
   "name": "Measurement integrity in certification",
   "definition": "Refuses to sign or certify what he has not measured; records actual rather than expected values and keeps measurements traceable."
  },
  {
   "id": "C28",
   "name": "Accepting correction and conceding error",
   "definition": "Concedes openly when evidence or a competent person shows him wrong, including subordinates, and revises his work, methods or explanations accordingly."
  },
  {
   "id": "C30",
   "name": "Systematic fault diagnosis",
   "definition": "Diagnoses faults by patient logging, isolation of variables and repeated tests, often succeeding where experts' quick heuristics failed."
  },
  {
   "id": "C31",
   "name": "Testing and documentation as part of completion",
   "definition": "Treats testing, cleanup, documentation and handover as necessary parts of finishing a job, including unpaid work."
  },
  {
   "id": "C34",
   "name": "Local precautions within risky ventures",
   "definition": "Measures or checks risk and moves carefully within a dangerous activity without treating the precautions as a reason to stop."
  },
  {
   "id": "C36",
   "name": "Insistence on work safety procedure",
   "definition": "Demands written lockouts, isolation and fall protection at work despite delay, impatience or lost income."
  },
  {
   "id": "C39",
   "name": "Concealing drinking and evading accountability",
   "definition": "Hides or minimises drinking, misses family commitments, drives after drinking, and answers confrontation with silence and a return to the bottle."
  },
  {
   "id": "C43",
   "name": "Organizing peers from a non-leading position",
   "definition": "Handles group logistics such as sign-up sheets while leaving visible leadership to others and staying peripheral in the activity."
  },
  {
   "id": "C54",
   "name": "Attachment expressed through presence and practical acts",
   "definition": "Shows care for grandmother, family and others through quiet presence, punctual attendance, practical help and preserved objects rather than words."
  },
  {
   "id": "C55",
   "name": "Hands-on fathering and teaching",
   "definition": "Fathers through practical care, protected custody time, and patient teaching of science to his children, following their questions and accepting their pushback."
  },
  {
   "id": "C56",
   "name": "Emotionally flat narration",
   "definition": "Feelings, including about loss and major ruptures, are left unnamed and conveyed only through objects, actions and inventories."
  },
  {
   "id": "C57",
   "name": "Rare evaluative words in narration",
   "definition": "Single evaluative or self-reproaching words ('stupidly', 'mercifully', 'happily') break otherwise affectless narration."
  },
  {
   "id": "C58",
   "name": "Indirect approval from father and authorities",
   "definition": "Seeks father's recognition through precision and competence, but approval from father or authority figures arrives only indirectly, tersely or as a jab."
  },
  {
   "id": "C59",
   "name": "Identification with father's exactness ethic",
   "definition": "Adopts his father's ethic of exactness and value, and after the death continues the father's ledger forms and column widths."
  },
  {
   "id": "C60",
   "name": "Rivalry with older brother",
   "definition": "Competes with older brother over space, facts and possessions, insisting on being right and proving him wrong with evidence or action."
  },
  {
   "id": "C62",
   "name": "Minimal rationed family contact",
   "definition": "Family appears rarely; contact is brief, timed and costed."
  },
  {
   "id": "C64",
   "name": "Concealment and partial truths",
   "definition": "Hides valued or damaged things and uses omissions, false accounts or literal partial truths to avoid disclosure."
  },
  {
   "id": "C67",
   "name": "Explicit financial categories",
   "definition": "Keeps personal and business money distinct and records help, losses and depletion honestly in proper categories."
  },
  {
   "id": "C68",
   "name": "Literal honesty about own labour and value",
   "definition": "Records hours and quantities exactly, refuses to inflate or claim unpaid time, and separates paid work from voluntary effort."
  },
  {
   "id": "C69",
   "name": "Applying rules to himself",
   "definition": "Holds himself to the same rules and accountability he imposes on others, including when leading shared systems."
  },
  {
   "id": "C72",
   "name": "Loyal companionship with Person 24",
   "definition": "Sustains a close bond with friend Person 24 through routines and technical talk, and stays present through his relapses."
  },
  {
   "id": "C73",
   "name": "Hiring against the ledger's verdict",
   "definition": "Takes on or keeps employees and apprentices despite financial calculations warning against it."
  },
  {
   "id": "C75",
   "name": "Closing rituals of checking locks",
   "definition": "Ends episodes by checking locks, handles and lights repeatedly."
  },
  {
   "id": "C76",
   "name": "Clock and quota governance of effort",
   "definition": "Uses the clock, fixed stop times and self-set quotas or tracked units to govern work and endings."
  },
  {
   "id": "C77",
   "name": "Resourcefulness with salvaged materials",
   "definition": "Collects discarded materials and adapts inexpensive objects into useful equipment."
  },
  {
   "id": "C78",
   "name": "Learning by close observation",
   "definition": "Observes others closely and imitates ordered procedures before entering unfamiliar roles or tasks."
  },
  {
   "id": "C79",
   "name": "Responsible handling of obligations",
   "definition": "Fulfils clear recurring duties reliably and, when a commitment becomes unsustainable, ends it explicitly with handover or sustains it through workarounds."
  }
