      "enum": [
       "F1",
       "F2",
       "F3"
      ]
     },
     "decision": {
      "type": "string",
      "enum": [
       "keep",
       "drop"
      ]
     },
     "reason": {
      "type": "string",
      "maxLength": 300
     }
    },
    "required": [
