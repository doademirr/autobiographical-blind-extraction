{
 "type": "object",
 "properties": {
  "codes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "prediction_id": {
      "type": "string",
      "pattern": "^P[0-9]{1,3}$"
     },
     "construct_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
     },
     "code": {
      "type": "string",
      "enum": [
       "match",
       "partial",
       "none"
      ]
     },
     "polarity": {
      "type": "string",
      "enum": [
       "same",
       "opposite",
       "unclear"
      ]
     }
    },
    "required": [
     "prediction_id",
     "construct_id",
     "code",
     "polarity"
    ],
    "additionalProperties": false
   }
  },
  "predictions": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "prediction_id": {
      "type": "string",
      "pattern": "^P[0-9]{1,3}$"
     },
     "facets": {
      "type": "array",
      "maxItems": 3,
      "items": {
       "type": "object",
       "properties": {
        "facet": {
         "type": "string",
         "description": "a facet code; the allowed codes are filled in from the frozen instrument at prepare"
        },
        "polarity": {
         "type": "string",
         "enum": [
          "+",
          "-"
         ]
        }
       },
       "required": [
        "facet",
        "polarity"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "prediction_id",
     "facets"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "codes",
  "predictions"
 ],
 "additionalProperties": false
}
